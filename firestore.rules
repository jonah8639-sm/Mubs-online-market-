rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email.lower() == "jonah8639@gmail.com";
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        isSuperAdmin() || 
        request.auth.uid == resource.data.seller_id
      );
    }

    match /chats/{chatId} {
      allow read: if request.auth != null && (
        isSuperAdmin() || 
        request.auth.uid == resource.data.buyerId || 
        request.auth.uid == resource.data.sellerId
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        isSuperAdmin() || 
        request.auth.uid == resource.data.buyerId || 
        request.auth.uid == resource.data.sellerId
      );
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if isSuperAdmin();
      }
    }

    match /transactions/{docId} {
      allow read: if request.auth != null && (
        isSuperAdmin() || 
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.sellerId ||
        request.auth.uid == resource.data.buyerId
      );
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }

    match /commissions/{docId} {
      allow read: if request.auth != null && (
        isSuperAdmin() || 
        request.auth.uid == resource.data.seller_id ||
        request.auth.uid == resource.data.sellerId ||
        request.auth.uid == resource.data.buyerId
      );
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }

    match /escrow_wallet/{docId} {
      allow read: if request.auth != null && (
        isSuperAdmin() || 
        request.auth.uid == resource.data.sellerId ||
        request.auth.uid == resource.data.buyerId
      );
      allow create, update: if request.auth != null;
      allow delete: if isSuperAdmin();
    }

    match /contact_requests/{docId} {
      allow read: if request.auth != null && (
        isSuperAdmin() || 
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.senderId
      );
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }

    match /config/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /boost_requests/{requestId} {
      allow read: if request.auth != null && (
        isSuperAdmin() || 
        request.auth.uid == resource.data.seller_id
      );
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }

    match /premium_requests/{requestId} {
      allow read: if request.auth != null && (
        isSuperAdmin() || 
        request.auth.uid == resource.data.seller_id
      );
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        (request.auth.uid == userId && (
          !('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false
        ))
      );
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isMubsVerified', 
            'is_banned', 
            'verification_status', 
            'isAdmin', 
            'isOwner'
          ])
        )
      );
      allow delete: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}


